# ============================================================
# Road Sign Detection Using YOLOv8
# Git Ignore
# ============================================================


# ------------------------------------------------------------
# Python
# ------------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

*.so
.Python

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/

*.egg-info/
.installed.cfg
*.egg
MANIFEST


# ------------------------------------------------------------
# Virtual Environment
# ------------------------------------------------------------

venv/
env/
.venv/
ENV/
env.bak/
venv.bak/


# ------------------------------------------------------------
# Environment / Secrets
# ------------------------------------------------------------

.env
.env.*
!.env.example

*.pem
*.key
secrets.json


# ------------------------------------------------------------
# IDE / Editors
# ------------------------------------------------------------

.vscode/
.idea/
*.code-workspace

# VS Code local history
.history/


# ------------------------------------------------------------
# Jupyter Notebook
# ------------------------------------------------------------

.ipynb_checkpoints/


# ------------------------------------------------------------
# YOLO / Ultralytics Training Outputs
# ------------------------------------------------------------

runs/
runs/**

# Training checkpoints
*.pt
*.pth
*.onnx
*.engine

# Keep final trained model
!models/
!models/best.pt

# TensorBoard
runs/**/events.out.tfevents.*


# ------------------------------------------------------------
# Dataset
# ------------------------------------------------------------

# Ignore the complete dataset
dataset/train/
dataset/valid/
dataset/test/

# Ignore stratified dataset
dataset/stratified/

# Ignore compressed datasets
dataset/*.zip
dataset/**/*.zip

# Ignore downloaded dataset archives
*.zip
*.7z
*.rar
*.tar
*.tar.gz


# ------------------------------------------------------------
# Flask Runtime Files
# ------------------------------------------------------------

# Uploaded images
static/uploads/*
!static/uploads/.gitkeep

# Generated prediction images
static/results/*
!static/results/.gitkeep

# Flask / temporary files
instance/
*.log


# ------------------------------------------------------------
# Generated Results / Temporary Analysis Files
# ------------------------------------------------------------

results/*
!results/.gitkeep

# Prediction outputs
predictions/
prediction/
outputs/
output/

# Generated CSV / JSON analysis files
*.csv
*.json

# If you want to keep a specific JSON file, whitelist it:
# !path/to/file.json


# ------------------------------------------------------------
# Python / Model Cache
# ------------------------------------------------------------

.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Ultralytics cache
*.cache


